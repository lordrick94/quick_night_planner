{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(python -)",
      "Bash(node --check frontend/app.js)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_usage.py\" 2>/dev/null",
            "timeout": 30,
            "statusMessage": "Logging token usage & CO2"
          }
        ]
      }
    ]
  }
}
